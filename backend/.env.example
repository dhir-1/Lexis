# Database Persistence (Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@your-host-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# Groq Cloud API Key (Whisper Large V3 Turbo & LLaMA 3.1)
