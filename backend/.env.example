# Database Persistence (Neon / PostgreSQL)
DATABASE_URL=postgresql://user:password@your-host-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# Groq Cloud API Key (Whisper Large V3 Turbo Speech Recognition)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Gemini 1.5 Flash ASL Gloss-to-Sentence & Speech Translation)
GEMINI_API_KEY=your_gemini_api_key_here

# Hardware & Engine Flags
ENABLE_AUDIO=1
VISION_CAMERA_INDEX=0
